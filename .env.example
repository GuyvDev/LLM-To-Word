# Optional public API configuration. Do not place secrets in this file.
PORT=8000
RELEASE_VERSION=1.0.0

# "*" permits browser clients from any origin; use an explicit comma-separated
# allowlist when hosting a private/internal deployment.
CORS_ORIGINS=*

# Resource and abuse controls. Use a reverse proxy for distributed rate limiting.
MAX_REQUEST_BYTES=262144
MAX_MARKDOWN_CHARS=200000
MAX_CONCURRENT_CONVERSIONS=4
RATE_LIMIT_PER_MINUTE=30
ENABLE_DOCS=false

# Enable only behind your load balancer and set its actual source addresses.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=<proxy-ip-1>,<proxy-ip-2>
